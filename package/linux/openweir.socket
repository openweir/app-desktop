# OpenWeir's control socket (docs/architecture.md "Linux", D60). Every local user
# may connect; the service checks each peer itself, by SO_PEERCRED and /proc/<pid>/exe, and
# answers only /opt/openweir/openweir-ui, and its own executable for root (the pkexec helpers).
[Unit]
Description=OpenWeir control socket
Documentation=https://github.com/openweir/app-desktop

[Socket]
ListenStream=/run/openweir/control.sock
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
